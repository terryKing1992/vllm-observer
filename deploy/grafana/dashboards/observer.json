{
  "uid": "vllm-observer",
  "title": "vLLM Observer · 主动上报",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "在线副本（心跳30秒内）",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count((observer_instance_alive == 1) and (time() - observer_heartbeat_timestamp_seconds < 30) and (time() - observer_heartbeat_timestamp_seconds >= 0)) or vector(0)",
          "legendFormat": "{{service}} {{instance_id}} {{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "健康副本",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count((observer_model_healthy == 1) and (observer_instance_alive == 1) and (time() - observer_heartbeat_timestamp_seconds < 30) and (time() - observer_heartbeat_timestamp_seconds >= 0)) or vector(0)",
          "legendFormat": "{{service}} {{instance_id}} {{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "副本心跳年龄 / 秒",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - observer_heartbeat_timestamp_seconds",
          "legendFormat": "{{service}} {{instance_id}} {{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "副本健康状态",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "observer_model_healthy and (observer_instance_alive == 1) and (time() - observer_heartbeat_timestamp_seconds < 30) and (time() - observer_heartbeat_timestamp_seconds >= 0)",
          "legendFormat": "{{service}} {{instance_id}} {{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "请求速率 / 秒",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(observer_requests_total[5m]) and on(service,model,instance_id) ((observer_instance_alive == 1) and (time() - observer_heartbeat_timestamp_seconds < 30) and (time() - observer_heartbeat_timestamp_seconds >= 0))",
          "legendFormat": "{{service}} {{instance_id}} {{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "请求 P95 / 秒",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le,service,model,instance_id)(rate(observer_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{service}} {{instance_id}} {{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "处理中请求",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "observer_requests_inflight and on(service,model,instance_id) ((observer_instance_alive == 1) and (time() - observer_heartbeat_timestamp_seconds < 30) and (time() - observer_heartbeat_timestamp_seconds >= 0))",
          "legendFormat": "{{service}} {{instance_id}} {{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "上报失败累计",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "observer_push_failures_total",
          "legendFormat": "{{service}} {{instance_id}} {{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "阶段平均时间 / 秒",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(observer_stage_seconds_total[5m]) / rate(observer_stage_observations_total[5m])",
          "legendFormat": "{{service}} {{instance_id}} {{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}
